# ──────────────────────────────────────────────────────────────
#  Phishing Triage Bot – Environment Variables
#  Copy this file to .env and fill in your real keys.
# ──────────────────────────────────────────────────────────────

# Telegram Bot token (get from @BotFather)
TELEGRAM_TOKEN=

# Enable/disable Telegram bot runtime (default: true)
TELEGRAM_ENABLED=true

# Comma-separated list of Telegram chat IDs allowed to use the bot.
# Leave empty to allow all chats (not recommended for production).
ALLOWED_CHAT_IDS=

# ── AI Classifier ────────────────────────────────────────────

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Local bilingual classifier runs first and never performs network access.
LOCAL_AI_ENABLED=true
LOCAL_AI_MODEL_DIR=artifacts/models/phishing-mmbert-v2
LOCAL_AI_MAX_LENGTH=256

# Use Groq only when the local model is uncertain or unavailable.
AI_GROQ_FALLBACK=false
GROQ_MODEL=llama-3.3-70b-versatile

# ── FastAPI Security / Limits ───────────────────────────────

# Runtime environment (prod or dev). In dev, API_KEY can be omitted for local testing.
ENV=prod
API_HOST=127.0.0.1

# Enable/disable API key protection for API endpoints (default: true)
API_PROTECTION_ENABLED=true

# Shared API key required in X-API-Key header for API endpoints (except /health)
API_KEY=

# Simple in-memory rate limit per client IP
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000

# Maximum upload size for .eml files (default: 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_RAW_EMAIL_CHARS=10485760
MAX_URLS_PER_EMAIL=50
MAX_ATTACHMENTS_PER_EMAIL=25

# Disable optional remote AI. Intrinsic analyzers never perform network lookups.
OFFLINE_MODE=false
LAB_MODE=false

# Wazuh JSONL sink; one object per completed analysis.
# Linux default: /var/log/phishing-bot/events.jsonl
# Windows default: logs/events.jsonl
# Set EVENTS_JSONL_PATH= to disable file output (siem_event is still returned).
# EVENTS_JSONL_PATH=/var/log/phishing-bot/events.jsonl

# Directory to store uploaded .eml files and extracted attachments
UPLOAD_DIR=uploads

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
