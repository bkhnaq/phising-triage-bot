# ──────────────────────────────────────────────────────────────
#  Phishing Triage Bot – Environment Variables
#  Copy this file to .env and fill in your real keys.
# ──────────────────────────────────────────────────────────────

# Telegram Bot token (get from @BotFather)
TELEGRAM_TOKEN=

# Enable/disable Telegram bot runtime (default: true)
TELEGRAM_ENABLED=true

# Comma-separated list of Telegram chat IDs allowed to use the bot.
# Leave empty to allow all chats (not recommended for production).
ALLOWED_CHAT_IDS=

# ── Threat Intelligence APIs ─────────────────────────────────

# VirusTotal API key (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# AlienVault OTX API key (https://otx.alienvault.com/accounts/signup)
ALIENVAULT_OTX_API_KEY=

# AbuseIPDB API key (https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=

# SecurityTrails API key (https://securitytrails.com/app/signup)
SECURITYTRAILS_API_KEY=

# ── AI Classifier ────────────────────────────────────────────

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Local bilingual classifier runs first and never performs network access.
LOCAL_AI_ENABLED=true
LOCAL_AI_MODEL_DIR=artifacts/models/phishing-mmbert
LOCAL_AI_MAX_LENGTH=512

# Use Groq only when the local model is uncertain or unavailable.
AI_GROQ_FALLBACK=false
GROQ_MODEL=llama-3.3-70b-versatile

# ── Optional Tuning ──────────────────────────────────────────

# Risk scoring thresholds (defaults: HIGH=70, MEDIUM=40)
# RISK_HIGH_THRESHOLD=70
# RISK_MEDIUM_THRESHOLD=40

# Log level (default: INFO)
# LOG_LEVEL=INFO

# ── FastAPI Security / Limits ───────────────────────────────

# Runtime environment (prod or dev). In dev, API_KEY can be omitted for local testing.
ENV=prod

# Enable/disable API key protection for API endpoints (default: true)
API_PROTECTION_ENABLED=true

# Shared API key required in X-API-Key header for API endpoints (except /health)
API_KEY=

# Simple in-memory rate limit per client IP
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000

# Maximum upload size for .eml files (default: 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_RAW_EMAIL_CHARS=10485760
MAX_URLS_PER_EMAIL=50
MAX_ATTACHMENTS_PER_EMAIL=25
SAFE_HTTP_MAX_BYTES=80000
SAFE_HTTP_TIMEOUT_SECONDS=6
SAFE_HTTP_MAX_REDIRECTS=10

# Skip external network lookups (VT/OTX/WHOIS/DNS/redirects/AI) for demos/tests
OFFLINE_MODE=false

# Cache successful external lookup responses in memory
THREAT_INTEL_CACHE_TTL_SECONDS=900

# Max parallel workers for independent threat-intel lookups
THREAT_INTEL_MAX_WORKERS=8

# Risk scoring thresholds (0-100)
RISK_HIGH_THRESHOLD=70
RISK_MEDIUM_THRESHOLD=40

# Directory to store uploaded .eml files and extracted attachments
UPLOAD_DIR=uploads

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
